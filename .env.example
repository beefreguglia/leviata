# ===== Banco de dados =====
# Local: `npm run db:start` (Prisma Postgres local). Produção: string do Supabase (Session pooler).
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"

# ===== Auth.js =====
AUTH_SECRET="" # gere com: npx auth secret
# Login de desenvolvimento (sem Discord). NUNCA ative em produção.
AUTH_DEV_LOGIN="true"

# ===== Discord =====
# Crie um app em https://discord.com/developers/applications → OAuth2.
# Redirect: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
# ID do servidor da Leviata (Modo desenvolvedor → botão direito no servidor → Copiar ID)
# Opcional: vazio = qualquer conta do Discord entra com ficha SEM patente (promova em Membros)
DISCORD_GUILD_ID=""
# Webhook do canal de avisos (Editar canal → Integrações → Webhooks)
DISCORD_WEBHOOK_AVISOS=""

# ===== Uploads =====
# Sem Supabase configurado, as imagens ficam na pasta .uploads/ (só para desenvolvimento).
# Produção: crie um bucket PRIVADO no Supabase Storage e preencha:
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="leviata"

# ===== Lives =====
# Twitch: https://dev.twitch.tv/console/apps → Register Your Application (OAuth Redirect: http://localhost)
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
# YouTube: Google Cloud Console → APIs → YouTube Data API v3 → Credenciais → Chave de API
YOUTUBE_API_KEY=""
# Webhook do canal de lives no Discord (se vazio, usa o de avisos)
DISCORD_WEBHOOK_LIVES=""
# Segredo para a rota /api/cron/streams (gere com: openssl rand -hex 24)
CRON_SECRET=""

# ===== Operações (Fase 3) =====
# Webhook do canal de ações/escalações (se vazio, usa o de avisos)
DISCORD_WEBHOOK_ACOES=""
# Webhook do canal de novidades: a cada deploy de produção posta o que mudou (src/lib/changelog.ts)
DISCORD_WEBHOOK_NOVIDADES=""
# URL pública do painel, usada nos links das mensagens do Discord (ex.: https://leviata.vercel.app)
AUTH_URL=""

# ===== Produção (ver DEPLOY.md) =====
# Supabase: DATABASE_URL = "Transaction pooler" (porta 6543); DIRECT_URL = "Session pooler" (porta 5432, usada nas migrações)
DIRECT_URL=""
# Conexões por instância (serverless): 3 é um bom valor na Vercel
DATABASE_POOL_MAX=""
# Discord IDs (separados por vírgula) com ACESSO TOTAL: entram como Líder no primeiro acesso e depois
# continuam podendo tudo mesmo que a patente exibida seja outra (ex.: Recruta). Mantenha só quem administra o painel.
BOOTSTRAP_ADMIN_DISCORD_IDS=""
